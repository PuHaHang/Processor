## 📖 Example Code

### Basic Test Class Structure

```python
"""
DataProcessor 테스트 모듈

이 모듈은 DataProcessor 클래스의 모든 기능을 검증하는 단위 테스트를 제공합니다.
데이터 처리, 변환, 유효성 검증 등의 기능을 포괄적으로 테스트합니다.
"""

import pytest
from unittest.mock import Mock, patch, MagicMock
from src.data_processor import DataProcessor
from src.exceptions import DataProcessingError


class TestDataProcessor:
    """
    DataProcessor 클래스에 대한 테스트 모음
    
    데이터 처리기의 초기화, 데이터 변환, 유효성 검증 등의
    모든 기능을 체계적으로 테스트합니다.
    """
    
    @pytest.fixture
    def mock_data_source(self):
        """
        테스트용 데이터 소스 Mock을 제공하는 fixture
        
        Returns:
            Mock: 테스트용 데이터 소스 Mock 객체
        """
        mock_source = Mock()
        mock_source.get_data.return_value = {
            "id": 1,
            "name": "test_data",
            "value": 100
        }
        return mock_source
    
    @pytest.fixture
    def data_processor(self, mock_data_source):
        """
        테스트용 DataProcessor 인스턴스를 제공하는 fixture
        
        Args:
            mock_data_source: Mock 데이터 소스
            
        Returns:
            DataProcessor: 테스트용 데이터 처리기 인스턴스
        """
        return DataProcessor(data_source=mock_data_source)
    
    @pytest.fixture
    def sample_valid_data(self):
        """
        유효한 테스트 데이터를 제공하는 fixture
        
        Returns:
            dict: 유효한 테스트 데이터
        """
        return {
            "id": 1,
            "name": "valid_data",
            "value": 200,
            "timestamp": "2024-01-01T00:00:00Z"
        }
    
    @pytest.fixture
    def sample_invalid_data(self):
        """
        유효하지 않은 테스트 데이터를 제공하는 fixture
        
        Returns:
            dict: 유효하지 않은 테스트 데이터
        """
        return {
            "id": None,  # 필수 필드가 None
            "name": "",  # 빈 문자열
            "value": -1  # 유효하지 않은 값
        }
    
    @pytest.mark.unit
    def test_data_processor_initialization(self, data_processor):
        """
        DataProcessor 초기화 테스트
        
        Args:
            data_processor: DataProcessor 인스턴스
        """
        # 검증
        assert isinstance(data_processor, DataProcessor)
        assert data_processor.data_source is not None
        assert hasattr(data_processor, 'process')
        assert hasattr(data_processor, 'validate')
    
    @pytest.mark.unit
    def test_process_valid_data_success(self, data_processor, sample_valid_data):
        """
        유효한 데이터 처리 성공 테스트
        
        Args:
            data_processor: DataProcessor 인스턴스
            sample_valid_data: 유효한 테스트 데이터
        """
        # 테스트 실행
        result = data_processor.process(sample_valid_data)
        
        # 검증
        assert result is not None
        assert result["status"] == "success"
        assert result["processed_data"]["id"] == sample_valid_data["id"]
        assert result["processed_data"]["name"] == sample_valid_data["name"]
        assert result["processed_data"]["value"] == sample_valid_data["value"]
    
    @pytest.mark.unit
    def test_process_invalid_data_raises_exception(self, data_processor, sample_invalid_data):
        """
        유효하지 않은 데이터 처리 시 예외 발생 테스트
        
        Args:
            data_processor: DataProcessor 인스턴스
            sample_invalid_data: 유효하지 않은 테스트 데이터
        """
        # 테스트 실행 및 검증
        with pytest.raises(DataProcessingError) as exc_info:
            data_processor.process(sample_invalid_data)
        
        assert "Invalid data format" in str(exc_info.value)
        assert exc_info.value.error_code == "INVALID_FORMAT"
    
    @pytest.mark.unit
    @patch('src.data_processor.external_api_call')
    def test_process_with_external_api_success(self, mock_api_call, data_processor, sample_valid_data):
        """
        외부 API 호출이 포함된 데이터 처리 성공 테스트
        
        Args:
            mock_api_call: 외부 API 호출 Mock
            data_processor: DataProcessor 인스턴스
            sample_valid_data: 유효한 테스트 데이터
        """
        # Mock 설정
        mock_api_call.return_value = {
            "status": "success",
            "enriched_data": {"additional_info": "test_info"}
        }
        
        # 테스트 실행
        result = data_processor.process(sample_valid_data, enrich=True)
        
        # 검증
        assert result["status"] == "success"
        assert "enriched_data" in result
        assert result["enriched_data"]["additional_info"] == "test_info"
        
        # Mock 호출 검증
        mock_api_call.assert_called_once_with(sample_valid_data)
    
    @pytest.mark.unit
    @patch('src.data_processor.external_api_call')
    def test_process_with_external_api_failure(self, mock_api_call, data_processor, sample_valid_data):
        """
        외부 API 호출 실패 시 처리 테스트
        
        Args:
            mock_api_call: 외부 API 호출 Mock
            data_processor: DataProcessor 인스턴스
            sample_valid_data: 유효한 테스트 데이터
        """
        # Mock 설정 - API 호출 실패
        mock_api_call.side_effect = ConnectionError("API connection failed")
        
        # 테스트 실행
        result = data_processor.process(sample_valid_data, enrich=True)
        
        # 검증 - 실패해도 기본 처리는 수행됨
        assert result["status"] == "partial_success"
        assert "error" in result
        assert "API connection failed" in result["error"]
    
    @pytest.mark.unit
    @pytest.mark.parametrize("test_data,expected_valid", [
        ({"id": 1, "name": "test", "value": 100}, True),
        ({"id": 2, "name": "another", "value": 0}, True),
        ({"id": None, "name": "test", "value": 100}, False),
        ({"id": 1, "name": "", "value": 100}, False),
        ({"id": 1, "name": "test", "value": -1}, False),
        ({}, False),
    ])
    def test_validate_data_with_various_inputs(self, data_processor, test_data, expected_valid):
        """
        다양한 입력에 대한 데이터 유효성 검증 테스트
        
        Args:
            data_processor: DataProcessor 인스턴스
            test_data: 테스트할 데이터
            expected_valid: 기대되는 유효성 결과
        """
        # 테스트 실행
        result = data_processor.validate(test_data)
        
        # 검증
        assert result["is_valid"] == expected_valid
        
        if not expected_valid:
            assert "errors" in result
            assert len(result["errors"]) > 0
    
    @pytest.mark.unit
    def test_data_source_integration(self, data_processor, mock_data_source):
        """
        데이터 소스 통합 테스트
        
        Args:
            data_processor: DataProcessor 인스턴스
            mock_data_source: Mock 데이터 소스
        """
        # 테스트 실행
        data = data_processor.get_source_data()
        
        # 검증
        assert data is not None
        assert data["id"] == 1
        assert data["name"] == "test_data"
        assert data["value"] == 100
        
        # Mock 호출 검증
        mock_data_source.get_data.assert_called_once()
    
    @pytest.mark.unit
    def test_batch_processing_success(self, data_processor):
        """
        배치 처리 성공 테스트
        
        Args:
            data_processor: DataProcessor 인스턴스
        """
        # 테스트 데이터 준비
        batch_data = [
            {"id": 1, "name": "item1", "value": 100},
            {"id": 2, "name": "item2", "value": 200},
            {"id": 3, "name": "item3", "value": 300}
        ]
        
        # 테스트 실행
        results = data_processor.process_batch(batch_data)
        
        # 검증
        assert len(results) == 3
        assert all(result["status"] == "success" for result in results)
        assert results[0]["processed_data"]["id"] == 1
        assert results[1]["processed_data"]["id"] == 2
        assert results[2]["processed_data"]["id"] == 3
    
    @pytest.mark.unit
    def test_batch_processing_with_partial_failures(self, data_processor):
        """
        배치 처리 중 일부 실패 시 처리 테스트
        
        Args:
            data_processor: DataProcessor 인스턴스
        """
        # 테스트 데이터 준비 - 일부 유효하지 않은 데이터 포함
        batch_data = [
            {"id": 1, "name": "item1", "value": 100},      # 유효
            {"id": None, "name": "item2", "value": 200},   # 유효하지 않음
            {"id": 3, "name": "item3", "value": 300}       # 유효
        ]
        
        # 테스트 실행
        results = data_processor.process_batch(batch_data, fail_fast=False)
        
        # 검증
        assert len(results) == 3
        assert results[0]["status"] == "success"
        assert results[1]["status"] == "error"
        assert results[2]["status"] == "success"
        
        # 에러 세부사항 확인
        assert "error" in results[1]
        assert "Invalid data format" in results[1]["error"]


